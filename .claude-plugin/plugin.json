{
  "name": "clause-analyser",
  "displayName": "Clause Analyser",
  "version": "0.1.0",
  "description": "Rates the dispute resolution (arbitration) clause of an agreement on Presolv360's 5-point scale.",
  "author": {"name": "Presolv360"},
  "homepage": "https://github.com/rishabhhirwe/clause-analyser",
  "repository": "https://github.com/rishabhhirwe/clause-analyser",
  "license": "MIT",
  "keywords": ["arbitration", "dispute-resolution", "contracts", "legal"],
  "skills": ["./.claude/skills/"],
  "mcpServers": {
    "dispute-clause-analyzer": {
      "command": "uv",
      "args": ["run", "--directory", "${CLAUDE_PLUGIN_ROOT}", "dispute-clause-analyzer"]
    }
  }
}
